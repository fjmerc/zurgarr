# Zurgarr Configuration
# =====================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only uncomment and set the values you need.
# The docker-compose.yml reads from this file automatically.
# You can also configure most settings via the web UI at /settings
# after setting STATUS_UI_AUTH below.

# --- Timezone ---
# TZ=America/New_York

# --- Zurg (debrid service) ---
ZURG_ENABLED=true
RD_API_KEY=              # Required: from https://real-debrid.com/apitoken
# AD_API_KEY=            # AllDebrid API key (alternative to RD)
# TORBOX_API_KEY=        # TorBox API key — powers cache probes, search-add,
                         # and the dual-debrid blackhole router (plan 39).
                         # For the WebDAV mount, also set the two vars below.
# ZURG_VERSION=          # Pin version (e.g., v0.9.2-hotfix.4)
# ZURG_UPDATE=true       # Auto-update Zurg on startup
# ZURG_LOG_LEVEL=INFO
# ZURG_PORT=             # WebDAV port (auto-assigned if empty)
# ZURG_USER=             # WebDAV basic auth username
# ZURG_PASS=             # WebDAV basic auth password

# --- TorBox WebDAV mount (plan 39) ---
# TorBox runs its own WebDAV at https://webdav.torbox.app/, separate from Zurg.
# These vars enable the second rclone mount inside the container at
# /data/$TORBOX_MOUNT_NAME/.  Zurg/RD stays untouched — TorBox is additive.
# WebDAV auth is HTTP Basic with the account email and a SEPARATELY configured
# WebDAV-only password (TorBox dashboard → Settings → Integrations → WebDAV).
# The TORBOX_API_KEY above does NOT authenticate the mount.
# TORBOX_WEBDAV_USER=         # TorBox account email
# TORBOX_WEBDAV_PASS=         # WebDAV-only password set in TorBox dashboard
# TORBOX_MOUNT_NAME=torbox    # Mount path under /data; must not collide with RCLONE_MOUNT_NAME
# TORBOX_RCLONE_TPSLIMIT=5    # Cap rclone requests-per-second on the TB mount (avoids "too many errors 11/10" 429 cascade under Plex/Bazarr scans). 0 = omit.
# TORBOX_RCLONE_TPSLIMIT_BURST=3  # Short-burst allowance above the tps limit. 0 = omit.
# TORBOX_RCLONE_DIR_CACHE_TIME=2h  # TB dir-listing cache TTL. Must exceed the library scan interval, else cold scans re-list all TB folders at the throttled tps limit and time out (TB titles flip to "Wanted").
# TORBOX_SCAN_TIMEOUT=180          # Seconds the library scan may spend walking the TB FUSE mount (separate from the 30s main deadline). Raise for very large TB libraries.

# --- rclone (mount) ---
RCLONE_MOUNT_NAME=zurgarr
# RCLONE_LOG_LEVEL=INFO
# NFS_ENABLED=false
# NFS_PORT=
# RCLONE_CACHE_DIR=/cache
# RCLONE_DIR_CACHE_TIME=10s
# RCLONE_VFS_READ_CHUNK_SIZE=32M
# RCLONE_VFS_READ_CHUNK_SIZE_LIMIT=1G
# RCLONE_BUFFER_SIZE=32M
# RCLONE_TRANSFERS=8
# RCLONE_VFS_CACHE_MODE=       # off|minimal|writes|full (default: off for FUSE, full for NFS)
# RCLONE_VFS_CACHE_MAX_SIZE=   # Max total size of VFS cache (e.g., 10G)
# RCLONE_VFS_CACHE_MAX_AGE=    # Max age of VFS cache files (e.g., 1h, 24h)

# --- plex_debrid ---
# PD_ENABLED=true        # Enable plex_debrid service
# PLEX_USER=             # Plex account username
# PLEX_TOKEN=            # Plex authentication token
# PLEX_ADDRESS=          # Plex server URL (e.g., http://192.168.1.100:32400)
# SHOW_MENU=false        # Show interactive menu on startup
# PD_UPDATE=true         # Auto-update plex_debrid
# PD_LOG_LEVEL=INFO
# PD_REPO=               # Override plex_debrid GitHub repo (owner/repo format)
# SEERR_API_KEY=         # Overseerr/Jellyseerr API key
# SEERR_ADDRESS=         # Overseerr/Jellyseerr URL
# SEERR_WRITEBACK_ENABLED=false  # close the request loop: mark requests available on delivery, decline movie requests on terminal give-up. Opt-in — mutates request state in Seerr (default: OFF)
# TRAKT_CLIENT_ID=       # Trakt API client ID
# TRAKT_CLIENT_SECRET=   # Trakt API client secret
# FLARESOLVERR_URL=http://flaresolverr:8191/v1
# PD_ENFORCE_CACHED_VERSIONS=false   # On startup, inject a cache-required rule into every plex_debrid content version.  RECOMMENDED ON for RD users — see TROUBLESHOOTING.md "DMM shows torrents at 0% with no seeds"

# --- Jellyfin ---
# JF_ADDRESS=            # Jellyfin server URL (e.g., http://192.168.1.100:8096)
# JF_API_KEY=            # Jellyfin API key

# --- Plex Library ---
# PLEX_REFRESH=true      # Auto-refresh Plex: Zurg's RD on_library_update hook AND the library scanner's post-symlink section refresh (covers TorBox/scanner content). Needs PLEX_ADDRESS + PLEX_TOKEN.
# PLEX_MOUNT_DIR=/zurgarr
# DUPLICATE_CLEANUP=false
# CLEANUP_INTERVAL=1     # Hours between duplicate cleanup runs
# DUPLICATE_CLEANUP_KEEP=local  # "local" (default, logs Zurg dupes) or "zurg" (deletes local copies)

# --- Notifications (Apprise) ---
# NOTIFICATION_URL=      # e.g., discord://webhook_id/webhook_token
# NOTIFICATION_EVENTS=startup,shutdown,mount_success,health_error
# NOTIFICATION_LEVEL=info
# NOTIFICATION_DIGEST_ENABLED=false  # Send a daily summary notification
# NOTIFICATION_DIGEST_TIME=08:00     # When to send the daily digest (24h format)

# --- Blackhole (Sonarr/Radarr integration) ---
# BLACKHOLE_ENABLED=false
# BLACKHOLE_DIR=/watch
#   BLACKHOLE_DIR supports two directory layouts (no extra env var):
#     Flat:    BLACKHOLE_DIR/<file>.torrent                  (single-arr installs)
#     Labeled: BLACKHOLE_DIR/sonarr/<file>.torrent           (each arr in its own subdir —
#              BLACKHOLE_DIR/radarr/<file>.magnet             prevents cross-arr orphan warnings)
#   Labeled symlinks are written under BLACKHOLE_COMPLETED_DIR/<label>/.
#   See BLACKHOLE_SYMLINK_GUIDE.md for the full labeled-layout setup and migration steps.
# BLACKHOLE_POLL_INTERVAL=5
# BLACKHOLE_DEBRID=realdebrid   # legacy single-debrid knob; superseded by BLACKHOLE_DEBRID_PRIMARY below.
# --- Multi-debrid routing (plan 39 phase 2) ---
# When both RD_API_KEY and TORBOX_API_KEY are set, each grab is routed
# independently.  Default is cache_aware: probe both for cache, prefer
# the cached side, fall back to primary on ties / unknown.
# BLACKHOLE_DEBRID_ROUTING=cache_aware   # cache_aware | primary_only
# BLACKHOLE_DEBRID_PRIMARY=realdebrid    # tiebreak + fallback target
# BLACKHOLE_SYMLINK_TARGET_BASE_TORBOX=  # Host-side path for TorBox symlinks
#                                        # (Plex sees as a separate library).
#                                        # Defaults to <BLACKHOLE_SYMLINK_TARGET_BASE>_torbox.

# --- Blackhole Symlink Mode ---
# Creates symlinks in /completed pointing to debrid mount for Sonarr/Radarr import.
# Also auto-creates symlinks in local library for debrid-only content so arrs can discover it.
# See BLACKHOLE_SYMLINK_GUIDE.md for full setup instructions.
# BLACKHOLE_SYMLINK_ENABLED=false
# BLACKHOLE_RCLONE_MOUNT=/data/zurgarr       # rclone mount path inside this container
# BLACKHOLE_SYMLINK_TARGET_BASE=/mnt/debrid   # same mount as seen by Plex/Sonarr/Radarr host(s)
# BLACKHOLE_COMPLETED_DIR=/completed          # staging directory for completed symlinks
# BLACKHOLE_MOUNT_POLL_TIMEOUT=300            # seconds to wait for content on mount
# BLACKHOLE_MOUNT_POLL_INTERVAL=10            # seconds between mount polls
# BLACKHOLE_SYMLINK_MAX_AGE=72               # hours before completed symlinks are cleaned up
# SYMLINK_REPAIR_AUTO_SEARCH=false           # trigger arr re-search when broken symlinks can't be repaired
# BLACKHOLE_DEDUP_ENABLED=true               # skip torrents that match existing local library
# BLACKHOLE_LOCAL_LIBRARY_TV=                 # local TV library path (for dedup + auto-symlinks)
# BLACKHOLE_LOCAL_LIBRARY_MOVIES=             # local movie library path (for dedup + auto-symlinks)

# --- Blackhole: debrid-account dedup & cache gate ---
# Distinct from BLACKHOLE_DEDUP_ENABLED above (which compares filenames
# against a local library).  These gate the add on the debrid account
# itself — see TROUBLESHOOTING.md "DMM shows torrents at 0% with no seeds".
# BLACKHOLE_DEBRID_DEDUP_ENABLED=true        # Skip if the hash is already on the debrid account (default: ON)
# BLACKHOLE_REQUIRE_CACHED=false             # Refuse drops not confirmed cached.  RD users leave OFF (no cache probe); AD/TB can turn ON
# BLACKHOLE_DELETE_UNCACHED_ON_TIMEOUT=false  # On timeout, actively delete the uncached torrent from the debrid account.  RECOMMENDED ON for RD users — prevents 0%/0-seed junk accumulation from failed grabs
# BLACKHOLE_TB_ALT_RECOVERY_ENABLED=true     # When a grabbed release is uncached, grab a same-title, same-tier alternative that IS cached on TorBox instead of dropping to "Wanted".  Requires TorBox configured (default: ON)
# BLACKHOLE_TB_ALT_MAX_ATTEMPTS=12           # Cached-alternative grabs for one season before giving up and falling back to "Wanted" (each re-arms TorBox's abuse cooldown). Persists across restarts; decays after 30 idle days (default: 12)
# BLACKHOLE_ARR_FAILED_FEEDBACK_ENABLED=true # On uncached reject, report the failed grab back to Sonarr/Radarr (blocklist + immediate re-search) instead of silently deleting — breaks the identical-re-grab loop (default: ON)
# BLACKHOLE_ARR_FEEDBACK_MAX_STRIKES=8       # Failed-download reports per title (per episode for TV) before giving up and reverting to silent deletion. Persists across restarts; decays after 30 idle days (default: 8)
# BLOCKLIST_AUTO_ADD=true                    # Automatically blocklist torrents that hit terminal debrid errors (default: ON)
# BLOCKLIST_EXPIRY_DAYS=0                    # Auto-expire auto-added blocklist entries after N days (0 = never). Manual entries are kept forever

# --- Debrid health reconciler (Real-Debrid keyword filter-gate detection) ---
# Periodically probes each RD torrent for the May 2026 infringing_file / error
# 35 filter blocks (Zurg's WebDAV listing keeps showing blocked torrents as
# healthy, so without this you see phantom library content that won't play).
# State persists to /config/debrid_health.json.  Detection only in this
# release; auto-remediation lands in a later phase.
# DEBRID_HEALTH_ENABLED=true                  # master kill switch for the probe sweep (default: ON)
# DEBRID_HEALTH_AUTO_REMEDIATE=false          # on detected block: blocklist hash, delete from RD, trigger arr re-search (default: OFF — mutates RD state, hard-capped at 100 per sweep)
# DEBRID_HEALTH_CROSS_RESCUE=                 # plan 39 phase 3: when RD filter-blocks a torrent and TB has it cached, re-host on TB and retarget arr-library symlinks (no blocklist, no delete, no re-search). Default: ON when both RD + TB API keys configured, OFF otherwise. Explicit true/false overrides.

# --- Debrid Quota / Expiry Dashboard ---
# Read-only per-provider poll: account expiry, storage usage, and near-expiry
# torrents (TorBox exposes per-torrent expires_at; RD/AD have no equivalent).
# Cards on the System page, zurgarr_debrid_* Prometheus gauges, and a
# change-gated debrid_expiry_warning notification. Never mutates debrid state.
# DEBRID_QUOTA_ENABLED=true                   # master toggle for the quota/expiry sweep (default: ON)
# DEBRID_EXPIRY_WARN_DAYS=7                   # warn when a torrent/account expires within this many days (default: 7)

# --- Status Web UI & Settings Editor ---
STATUS_UI_ENABLED=true
# STATUS_UI_PORT=8080
STATUS_UI_AUTH=admin:changeme   # CHANGE THIS — required for settings editor
# STATUS_UI_TRUSTED_ORIGINS=https://zurgarr.example.com
# HISTORY_RETENTION_DAYS=30       # Days to keep Activity-page history events

# --- Library Metadata ---
# TMDB_API_KEY=           # TMDB API key for show/movie metadata (free at themoviedb.org)

# --- Debrid Search (Library UI torrent search) ---
# TORRENTIO_URL=https://torrentio.strem.fun   # Enables interactive torrent search in the Library detail view
# PROWLARR_URL=http://prowlarr:9696          # Merge results from every Prowlarr indexer into manual search; Wanted recovery falls back to them when Torrentio has nothing usable
# PROWLARR_API_KEY=                           # Prowlarr API key (Settings -> General -> Security).  Sent as a header, never in URLs
# SEARCH_DEDUP_ENABLED=true                    # Refuse Add clicks for hashes already on the account (default: ON)
# SEARCH_REQUIRE_CACHED=false                  # Refuse Add clicks for uncached hashes.  Same RD caveat as BLACKHOLE_REQUIRE_CACHED
# WANTED_TB_RECOVERY_ENABLED=true              # Auto-grab TorBox-cached copies of "Wanted" titles the arr never grabbed (search Torrentio -> probe TB cache -> add to TB).  Requires TorBox + TORRENTIO_URL (default: ON)
# WANTED_TB_RECOVERY_MAX_PER_SCAN=2            # Max Wanted titles added to TorBox per library scan.  Kept small: create-volume bursts arm TB Essential's ~24h abuse cooldown
# WANTED_RD_RECOVERY_ENABLED=true              # RD leg of Wanted recovery: add top release to RD, keep if instantly ready (cached), else delete + fall back to TorBox.  Requires RealDebrid + TORRENTIO_URL (default: ON)
# WANTED_RD_RECOVERY_MAX_PER_SCAN=4            # Max RD probe-adds per library scan (attempts, not successes).  RD has no create cooldown; each uncached attempt costs up to ~20s of polling
# WANTED_SEASON_RECOVERY_ENABLED=true          # Also probe TB season packs for partial shows' seasons with missing aired episodes (TB-only, shares the TB per-scan budget).  Requires WANTED_TB_RECOVERY_ENABLED (default: ON)

# --- Tautulli watch correlation (optional) ---
# With Tautulli configured, Wanted recovery sorts never-played titles to the
# back of the queue so per-scan budgets flow to content people actually watch.
# Ordering only — nothing is skipped, and a Tautulli outage changes nothing.
# TAUTULLI_URL=http://tautulli:8181            # Tautulli base URL (read-only access)
# TAUTULLI_API_KEY=                            # Tautulli Settings → Web Interface → API key
# WANTED_DEPRIORITIZE_UNPLAYED=true            # sort never-played wanted titles last (inert without Tautulli; default: ON)
# TAUTULLI_HISTORY_DAYS=180                    # how far back a play counts as "played" (default: 180)
# GAP_FILL_ENABLED=true                        # Reconcile monitored shows against TMDB and search Sonarr/Radarr for aired episodes missing from both debrid and local; also re-search broken symlinks during verify (default: ON)

# --- Media Services (for Library "Download" button) ---
# Sonarr/Radarr: Download button triggers a search in Sonarr (TV) or Radarr (Movies)
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# Overseerr: Falls back to SEERR_ADDRESS/SEERR_API_KEY above if Sonarr/Radarr not configured
# ROUTING_AUTO_TAG_UNTAGGED=true         # Auto-apply debrid tag to monitored Sonarr series / Radarr movies with no routing tag during the 6h routing audit (set to 'false' to disable the self-heal)

# --- Library Preference Enforcement ---
# LIBRARY_PREFERENCE_AUTO_ENFORCE=false  # Auto-switch sources when content arrives (default: off, enable explicitly)
# DEBRID_UNAVAILABLE_THRESHOLD_DAYS=3    # Days before marking content as debrid-unavailable (default: 3)
# FORCE_GRAB_MAX_ATTEMPTS=12             # Force-grabs of a debrid release for one stuck title before giving up (each re-arms TorBox's abuse cooldown). Persists across restarts; resets on landing or after 30 idle days (default: 12)
# PENDING_WARNING_HOURS=24               # Hours before warning notification for stuck pending items (default: 24, 0 to disable)
# LIBRARY_RESCAN_NFS_DELAY=0             # Seconds to sleep between symlink creation and Sonarr/Radarr rescan (default: 0). Bump to 30 if your arr reads symlinks over NFS and reports hasFile=false right after a fresh grab. Clamped to [0,300]. See TROUBLESHOOTING for the symptom.

# --- Quality Compromise & Season-Pack Fallback (plan 33) ---
# Cache-aware smart compromise for the blackhole: after the arr's alternative
# list at the preferred tier is exhausted and a configurable dwell window
# has elapsed, probe Torrentio for a cached release one tier down the arr's
# quality profile and grab it — profile is still the ceiling, Sonarr's
# normal upgrade logic still fires when the preferred tier later appears.
# Ships OFF by default (feature is additive and strictly opt-in).
# QUALITY_COMPROMISE_ENABLED=false         # Master toggle.  All other QUALITY_COMPROMISE_* / SEASON_PACK_FALLBACK_* vars are inert while this is false.
# QUALITY_COMPROMISE_DWELL_DAYS=3          # Days of failed preferred-tier attempts before the first compromise may fire (invariant I3)
# QUALITY_COMPROMISE_MIN_SEEDERS=3         # Compromise candidates below this seeder floor are skipped (availability safety net)
# QUALITY_COMPROMISE_ONLY_CACHED=true      # Refuse to compromise to an uncached release (invariant I4 — trading quality for nothing is worse than no compromise).  Real-Debrid deprecated instant-availability Nov 2024, so RD users under strict mode will never compromise; flip to `false` for aggressive escalation.
# QUALITY_COMPROMISE_MAX_TIER_DROP=2       # Cap on how far below the preferred tier the engine may descend (1 = one drop only, 2 = up to two drops; default 2).  Set to a large value (e.g. 10) to effectively disable the cap — the arr's profile ceiling remains authoritative either way.
# QUALITY_COMPROMISE_NOTIFY=true           # Send an Apprise notification on each compromise grab.  Setting to `false` silences Apprise only — the dashboard history event and pending_monitors annotation still fire (invariant I7 — observability is non-negotiable).
# SEASON_PACK_FALLBACK_ENABLED=false       # Master toggle for the TV-only season-pack strategy: probe a cached pack at the preferred tier before dropping tier, so a show with many missing episodes gets filled in without a quality compromise.
# SEASON_PACK_FALLBACK_MIN_MISSING=4       # Minimum missing-episode count in the target season before a pack probe is attempted (absolute floor)
# SEASON_PACK_FALLBACK_MIN_RATIO=0.4       # Minimum missing/total ratio for the target season (belt-and-suspenders with MIN_MISSING).  Prevents a large season with 4/40 missing (10%) from triggering a 40-episode pack grab when only a few holes exist.  0.0 disables the ratio gate.

# --- Monitoring ---
# MOUNT_SELFHEAL_ENABLED=true               # Auto-recover a dead FUSE mount (stale mount-table corpse after a container recreate): lazy-unmount + restart the owning rclone after 2 consecutive dead liveness probes, max once per 10 min per mount.  Also retries mounts skipped at startup (WebDAV unreachable, e.g. container up before host network) until they come up.  `false` = detect + log only, manual recovery.
# FFPROBE_MONITOR_ENABLED=true
# FFPROBE_STUCK_TIMEOUT=300
# FFPROBE_POLL_INTERVAL=30
# AUTO_UPDATE_INTERVAL=12

# --- Logging ---
# ZURGARR_LOG_LEVEL=INFO
# ZURGARR_LOG_COUNT=2
# ZURGARR_LOG_SIZE=10M
# COLOR_LOG_ENABLED=false
# PD_LOGFILE=            # Path for plex_debrid log output

# --- Advanced ---
# GITHUB_TOKEN=          # Avoid GitHub API rate limits
# SKIP_VALIDATION=false  # Skip startup config validation

# --- Backups ---
# CONFIG_BACKUP_INTERVAL=86400    # Seconds between scheduled config backups (24h). 0 disables scheduled backups (manual still works).
# CONFIG_BACKUP_RETENTION=7       # Number of scheduled backup archives to keep
# CONFIG_BACKUP_DIR=/config/backups
